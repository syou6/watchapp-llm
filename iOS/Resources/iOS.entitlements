<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Empty by default so the app signs cleanly with a free Apple ID.

      When you enable the MLX / Qwen backend, large 4-bit models can exceed the
      default per-app memory ceiling. Add the increased-memory-limit entitlement
      then (it requires a paid Apple Developer account / provisioning profile):

        <key>com.apple.developer.kernel.increased-memory-limit</key>
        <true/>
    -->
</dict>
</plist>
